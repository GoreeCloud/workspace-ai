# OPTIONAL: separately billed API fallback; keep this file private.
# The server never forwards this credential to the browser.
OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-5-mini
# Local-only browser and backend; avoid exposing either to the public network.
WORKSPACE_AI_PORT=3031

# PRIVATE DEVELOPMENT ONLY (example; do not enable without an authenticated NetBird gateway).
# WORKSPACE_AI_PRIVATE_DEV_ENABLED=true
# WORKSPACE_AI_PRIVATE_DEV_ORIGIN=https://workspace-ai-dev.goreecloud.com
# Isolated Docker container only, never public or host-network port publishing:
# WORKSPACE_AI_PRIVATE_DEV_BIND_ALL=true
# WORKSPACE_AI_PRIVATE_DEV_ISOLATED_CONTAINER=true
