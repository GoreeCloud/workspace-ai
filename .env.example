# OPTIONAL: separately billed API fallback; keep this file private.
# The server never forwards this credential to the browser.
OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-5-mini
# Local-only browser and backend; avoid exposing either to the public network.
WORKSPACE_AI_PORT=3031

# Remote Operations and Chrome MCP: opt-in, local-only development.
# Keep the owner key, inventory, and SSH secrets outside Git.
WORKSPACE_REMOTE_OPS_ENABLE=false
WORKSPACE_REMOTE_OPS_ENABLE_WRITES=false
WORKSPACE_REMOTE_OPS_OWNER_KEY=
WORKSPACE_REMOTE_OPS_CONFIG=
WORKSPACE_CHROME_MCP_ENABLE=false
WORKSPACE_CHROME_MCP_EXECUTABLE=
WORKSPACE_CHROME_MCP_ALLOWED_HOSTS=
